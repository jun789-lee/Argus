{
  "name": "app-loop-runner",
  "version": "0.1.0",
  "type": "module",
  "description": "Argus auto-loop runner: runs work -> verify -> revise loops from a spec, with Claude Code as the worker.",
  "bin": {
    "argus-loop": "./bin/argus-loop.mjs"
  },
  "scripts": {
    "loop": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
